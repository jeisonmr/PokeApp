---
import { getIdPokemon } from "@/services/api.services";
import IdBanners from "@/data/data.json";
import SwiperSlider from "@/@core/components/Swiper/SwiperSlider.astro";
import Banner from "../ui/Banner.astro";


// Data API - Envolviendo en función async
const idBanners = IdBanners.idBanners;

const pokemonFromBanner = await Promise.all(
  idBanners.map(async (id: number) => {
    const pokemon = await getIdPokemon(id);
    const primaryType: any[] | string  = pokemon.types || "normal";
    return {
      name: pokemon.name,
      image: pokemon.sprites.other?.dream_world.front_default,
      type: primaryType, // Viene en inglés de la API
    };
  }),
);
---

<section class="Banner h-[80vh] relative max-desktop:hidden">
  <SwiperSlider
    Component={Banner}
    slideProps={pokemonFromBanner}
    swiperContainer="h-full"
    swiperWrapper="h-full"
    swiperSlide="h-full"
    swiperPagination=""
    swiperButtonPrev=""
    swiperButtonNext=""
    options={{
      effect: "fade",
      speed: 2000,
      loop: true,
      autoplay: {
        delay: 5000,
      },
    }}
  />
</section>