---
import Card from "../ui/Card.astro";
import SearchFilter from "@core/components/SearchFilter/SearchFilter.astro";
import type { PokemonProps } from "@/models/types/pokemon";
import Typographi from "@/@core/components/Typographi/Typographi.astro";
import { getNamePokemon } from "@/services/api.services";
import { normalizeType } from "@/utils/banner/banner";
import { array } from "astro:schema";

const { page } = Astro.props;

const pokemonsAll = page?.data ? await Promise.all(
      page.data.map(async (pokemon: PokemonProps) => {
        const data = await getNamePokemon(pokemon.name);
        const type = data.types.map((type: any) => type.type.name);
        console.log(type);
        return {
          name: data.name,
          image: data.sprites?.other?.home?.front_default,
          type: normalizeType(type),
          number: data.id,
        };
      }),
    )
  : [];

  console.log(pokemonsAll);
---
<section class="flex flex-col gap-2 h-screen">
  <Typographi
    component="h2"
    className="movil:text-txt-title3 desktop:text-txt-title2 font-primary-600 pt-2.5 desktop:pt-5"
  >
    Encuentra tu Pokémon
  </Typographi>

  <SearchFilter
    searchText
    selectType
    selectGeneration
    placeholder="Buscar tu Pokémon..."
    title="Búsqueda Instantánea"
    titleSelectType="Tipo"
    titleSelectGeneration="Generación"
  />

	<h3 class="text-txt-description2 font-primary-300">
	 {pokemonsAll.length} Pókemon <span class="tex-white">encontrados</span>
	</h3>

  <ul class="grid movil:grid-cols-2 desktop:grid-cols-3 gap-2 items-center justify-center">
    {
      pokemonsAll.map(({ name, image, type, number }) => {
        return (
          <li>
            <a href={`/pokemon/${name}?pages=${page?.currentPage}`}>
              <Card name={name} image={image} customCard={type} number={number} />
            </a>
          </li>
        );
      })
    }
  </ul>

  <nav class="flex gap-6 items-center">
    {page?.url?.prev && <a href={page.url.prev}>Anterior</a>}
    <span>Página {page?.currentPage} de {page?.lastPage}</span>
    {page?.url?.next && <a href={page.url.next}>Siguiente</a>}
  </nav>
</section>
