---
import Button from "@/@core/components/Button/Button.astro";
import ImagesResponsive from "@/@core/components/ImagesResponsive/ImagesResponsive.astro";
import Typographi from "@/@core/components/Typographi/Typographi.astro";
import { Image } from "astro:assets";
import { normalizeType } from "../../utils/banner/banner";
import iconPokeball from "@base/public/icons/pokeball.png";

export interface BannerUIProps{
  name?: string;
  description?: string;
  image?: string;
  type?: string;
  number?: number;
  singlePage?: boolean;
  idx?: number;
}

const { name, description, image, type, number, singlePage, idx } = Astro.props;

const types = type?.map(({type}:any) =>{
  return type.name
})

// Normalizar el tipo a español
const normalizedType = type 
? normalizeType(types) 
: "normal";

// Importar dinámicamente las imágenes según el tipo
const bgDesktop = `/images/banners_desktop/${normalizedType[0]}.webp`;
const bgMobile = `/images/banners_mobile/${normalizedType[0]}.webp`;
const iconMedal = Array.of(...normalizedType);
---
<article class="h-full">
  {
    (bgDesktop || bgMobile) && (
      <ImagesResponsive
        src={{ mobile: bgMobile, desktop: bgDesktop }}
        alt={`Pokémon tipo ${normalizedType}`}
        wrapperClass="absolute"
      />
      <div class="absolute inset-x-0 bottom-0 h-1/2 pointer-events-none bg-linear-to-t from-black via-black/40 to-transparent [clip-path:ellipse(75%_100%_at_50%_100%)]"></div>
    )
  }
  <div class="w-full h-full flex movil:flex-col-reverse desktop:flex-row justify-center movil:px-3 desktop:px-12">
    <div class="movil:h-60 desktop:h-[70vh] movil:w-full desktop:w-1/2 relative z-10 flex flex-col desktop:justify-center gap-1">
      <div class="flex flex-col movil:gap-2 desktop:gap-5">
        <Typographi
          component={(singlePage || idx === 0) ? "h1" : "h2"}
          className="capitalize text-4xl font-pokemon-300 text-txt-title0 text-white"
        >
          {name}
        </Typographi>
  
        <p class="text-white text-txt-description1 font-primary-300 w-full lg:w-[70%]">
          {description || name}
        </p>
      </div>

      {
        iconMedal.length > 0 && (
          <div class="flex gap-0.5 mt-1">
            {iconMedal.map((medal) => (
              <picture class="flex flex-col items-center justify-between gap-1 rounded-xs bg-black/30 p-1">
                <Image
                  src={`/icons/medals/${medal}.png`}
                  alt={`Icono de tipo ${medal}`}
                  width={20}
                  height={20}
                  class="w-4 h-4"
                />
                <label for="" class="text-white text-xs font-primary-600 uppercase">{medal}</label>
              </picture>
            ))}
            <Typographi 
              component="span" 
              className="font-pokemon-600 text-txt-title1 ml-1.5 text-white"
            >
              #{number}
            </Typographi>
          </div>
        )
      }
  
      <a 
        href={singlePage ? '#affinities-base' : `/pokemon/${name}`} 
        class="w-fit flex items-center justify-center gap-1 font-primary-600 text-txt-title3 bg-black/80 text-white rounded-xs p-1.5 cursor-pointer"
        aria-label="Más detalles"
        title="Más detalles"
      >
        <Image
          src={iconPokeball}
          alt="Flecha derecha"
          width={20}
          height={20}
          class="w-2 h-2"
        />
        Más detalles
      </a>
    </div>
  
    <div class="h-auto movil:w-full desktop:w-1/2 relative z-10 flex items-center justify-center max-desktop:pt-2">
      {image && (
        <a 
          href={singlePage ? '/' : `/pokemon/${name}`} 
          aria-label="Más detalles"
          class="cursor-pointer w-20 desktop:w-full xl:w-[80%] h-auto"
        >
          <Image
            loading="lazy"
            src={image}
            alt={name || "Pokemon"}
            title={`Ir a la interna de ${name}`}
            width={200}
            height={200}
            class="pokemon_image object-fill w-20 desktop:w-full xl:w-[80%] h-auto aspect-square"
            loading="lazy"
            decoding="async"
            fetchpriority="high"
            quality={50}
            format="webp"
          />
        </a>
      )}
    </div>
  </div>
</article>
