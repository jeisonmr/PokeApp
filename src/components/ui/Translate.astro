<div class="gtranslate_wrapper text-txt-description2 font-primary-300"></div>
<script>
  // Declarar interfaz para TypeScript
  declare global {
    interface Window {
      gtranslateSettings?: {
        default_language: string;
        native_language_names: boolean;
        languages: string[];
        wrapper_selector: string;
      };
    }
  }

  // Configuración inicial - solo definir una vez
  if (!window.gtranslateSettings) {
    window.gtranslateSettings = {
      "default_language": "es",
      "native_language_names": false,
      "detect_browser_language": false,  // Desactivar detección automática
      "languages": ["es", "en"],
      "wrapper_selector": ".gtranslate_wrapper"
    };
  }

  // Bandera para evitar carga duplicada
  let gtranslateLoaded = false;

  function loadGTranslate() {
    if (gtranslateLoaded) return; // Evitar carga duplicada
    gtranslateLoaded = true;

    // Eliminar scripts anteriores si existen
    const existingScripts = document.querySelectorAll('script[src*="gtranslate"]');
    existingScripts.forEach(script => script.remove());

    // Limpiar el wrapper
    const wrapper = document.querySelector('.gtranslate_wrapper');
    if (wrapper) {
      wrapper.innerHTML = '';
    }

    // Cargar el script del widget
    const script = document.createElement('script');
    script.src = 'https://cdn.gtranslate.net/widgets/latest/lc.js';
    script.defer = true;
    document.head.appendChild(script);
  }

  // Cargar solo cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadGTranslate);
  } else {
    loadGTranslate();
  }

  // Recargar cuando Astro ClientRouter navega entre páginas
  document.addEventListener('astro:page-load', () => {
    gtranslateLoaded = false; // Resetear la bandera
    loadGTranslate();
  });
</script>