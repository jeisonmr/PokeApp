---
import { Image } from "astro:assets";
import logo from "@base/public/icons/pokeball.png";
import Translate from "./Translate.astro";

---

<nav class="w-full py-1 movil:px-2 desktop:px-5 sticky top-0 left-0 z-20">
  <div class="flex justify-between items-center">
    <a href="/" class="" aria-label="Ir al inicio">
      <Image
        src={logo}
        alt="Ir al inicio"
        aria-hidden="true"
        width={32}
        height={32}
        class="w-[3.2rem] h-[3.2rem]"
      />
    </a>
    <Translate />
  </div>
</nav>
