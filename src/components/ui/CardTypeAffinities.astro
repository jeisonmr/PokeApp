---
import Icon from "@/@core/components/Icon/Icon.astro";
import Typographi from "@/@core/components/Typographi/Typographi.astro";
import { cardThemes } from "@/models/themes/cardThemes";
import { normalizeType } from "@/utils/banner/banner";
import { Image } from "astro:assets";

export interface CardTypeAffinitiesProps {
  type: string;
  className?: string;
  title: string;
  subtitle?: string;
  affinities?: any;
}

const { type, className, title, subtitle, affinities } = Astro.props as CardTypeAffinitiesProps;
const typeKey = normalizeType([type]);
const { border, tag, bgCardInternal } = cardThemes[typeKey[0]];
---

<article 
  class={`
  CardTypeAffinities border rounded-xs p-2 desktop:pb-2
  ${border.borderColor} 
  ${border.hoverBorderColor} 
  ${bgCardInternal} 
  ${className}
  `}
>
  <Typographi component="h3" className="text-txt-title3 font-primary-600">
    {title}
  </Typographi>
  {subtitle && (
    <Typographi component="p" className="text-txt-description4 font-primary-300 text-white/60">
      {subtitle}
    </Typographi>
  )}

  <div class="flex items-center gap-0.5 mt-1.5 flex-wrap">
    { affinities.map((tag: string) =>{
      const type = normalizeType([tag.name]);
      return (
      <div class={`bg-white/10 rounded-xs py-1 px-0.5 w-6 hover:scale-[1.05] transition-transform duration-200`}>
         <picture class="flex flex-col items-center justify-between gap-[0.3rem]">
          <Image
            src={`/icons/types/${type}.png`}
            alt={`Icono de tipo ${type}`}
            width={20}
            height={20}
            class="w-2 h-2"
          />
          <Typographi 
            component="span" 
            className="text-txt-description4 font-primary-300 capitalize"
          >
              {type}
          </Typographi>
        </picture>
      </div>
      )
    })}
  </div>
</article>