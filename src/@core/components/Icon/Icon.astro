---
import { Image } from "astro:assets";

export interface IconProps {
  icon?: "acero" | "agua" | "bicho" | "dragon" | "electrico" | "fantasma" | "fuego" | "hada" | "hielo" | "lucha" | "normal" | "planta" | "psíquico" | "roca" | "siniestro" | "tierra" | "veneno" | "volador" | "pokeball" | "github" | "linkedin" | "code" | "arrow_back" | "arrow_up" | "arrow_left";
  className?: string;
}

const { icon, className } = Astro.props;

const iconType = {
  acero: {url:"/icons/types/acero.png", width: 10, height: 10, alt:"Tipo Acero"},
  agua: {url:"/icons/types/agua.png", width: 10, height: 10, alt:"Tipo Agua"},
  bicho: {url:"/icons/types/bicho.png", width: 10, height: 10, alt:"Tipo Bicho"},
  dragon: {url:"/icons/types/dragon.png", width: 10, height: 10, alt:"Tipo Dragon"},
  electrico: {url:"/icons/types/electrico.png", width: 10, height: 10, alt:"Tipo Electrico"},
  fantasma: {url:"/icons/types/fantasma.png", width: 10, height: 10, alt:"Tipo Fantasma"},
  fuego: {url:"/icons/types/fuego.png", width: 10, height: 10, alt:"Tipo Fuego"},
  hada: {url:"/icons/types/hada.png", width: 10, height: 10, alt:"Tipo Hada"},
  hielo: {url:"/icons/types/hielo.png", width: 10, height: 10, alt:"Tipo Hielo"},
  lucha: {url:"/icons/types/lucha.png", width: 10, height: 10, alt:"Tipo Lucha"},
  normal: {url:"/icons/types/normal.png", width: 10, height: 10, alt:"Tipo Normal"},
  planta: {url:"/icons/types/planta.png", width: 10, height: 10, alt:"Tipo Planta"},
  psiquico: {url:"/icons/types/psiquico.png", width: 10, height: 10, alt:"Tipo Psíquico"},
  roca: {url:"/icons/types/roca.png", width: 10, height: 10, alt:"Tipo Roca"},
  siniestro: {url:"/icons/types/siniestro.png", width: 10, height: 10, alt:"Tipo Siniestro"},
  tierra: {url:"/icons/types/tierra.png", width: 10, height: 10, alt:"Tipo Tierra"},
  veneno: {url:"/icons/types/veneno.png", width: 10, height: 10, alt:"Tipo Veneno"},
  volador: {url:"/icons/types/volador.png", width: 10, height: 10, alt:"Tipo Volador"},
  pokeball: {url:"/icons/pokeball.png", width: 10, height: 10, alt:"Pokeball"},
  github: {url:"/icons/github.webp", width: 10, height: 10, alt:"Github"},
  linkedin: {url:"/icons/linkedin.webp", width: 10, height: 10, alt:"Linkedin"},
  code: {url:"/icons/code.webp", width: 10, height: 10, alt:"Code"},
  arrow_back: {url:"/icons/arrow_back.webp", width: 10, height: 10, alt:"Arrow Back"},
  arrow_up: {url:"/icons/arrow_up.webp", width: 10, height: 10, alt:"Arrow Up"},
  arrow_left: {url:"/icons/arrow_left.webp", width: 10, height: 10, alt:"Arrow Left"},
};
---

{
  iconType[icon as keyof typeof iconType] && (
    <Image 
      src={iconType[icon].url} 
      alt={iconType[icon].alt} 
      width={iconType[icon].width}
      height={iconType[icon].height}
      class={className} 
      loading="lazy"
      aria-hidden="true"
    />
  )
}