---
export interface Props {
  src:{
    mobile: string;
    desktop: string;
  };
  alt?: string;
  className?: {
    mobile?: string;
    desktop?: string;
  };
  wrapperClass?: string;
}

const { src, alt = "", className = { mobile: "", desktop: "" }, wrapperClass = "" } = Astro.props;
---

<div class={`ImageResponsive w-full h-full ${wrapperClass}`}>
  <img 
    src={src.mobile} 
    alt=""
    width="100%"
    height="100%"
    class={`${className.mobile || ""} images_mobile w-full h-full object-fill aspect-video desktop:hidden`}
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
  />
  <img
    src={src.desktop}
    alt=""
    width="100%"
    height="100%"
    class={`${className.desktop || ""} images_desktop w-full h-full object-fill aspect-square hidden desktop:block`}
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
  />
</div>
