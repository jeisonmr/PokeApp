---
import { Picture  } from 'astro:assets';

export interface Props {
  src:{
    mobile: string;
    desktop: string;
  };
  alt?: string;
  className?: {
    mobile?: string;
    desktop?: string;
  };
  wrapperClass?: string;
}

const { src, alt = "", className = { mobile: "", desktop: "" }, wrapperClass = "" } = Astro.props;
---

<div class={`ImageResponsive w-full h-full ${wrapperClass}`}>
  <Picture
    src={src.mobile}
    alt=""
    format={'webp'}
    quality={50}
    width={800}
    height={450}
    class={`${className.mobile || ''} images_mobile w-full h-full aspect-video object-cover desktop:hidden`}
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
  />

  <Picture
    src={src.desktop}
    alt=""
    format={'webp'}
    quality={50}
    width={1200}
    height={1200}
    class={`${className.desktop || ''} images_desktop w-full h-full aspect-square object-cover hidden desktop:block`}
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
  />
</div>
