---

import Typographi from "../Typographi/Typographi.astro";
import {types, generations} from "@/data/data.json";

export interface SearchProps {
  placeholder?: string;
  title?: string;
  titleSelectType?: string;
  titleSelectGeneration?: string;
  searchText?: boolean;
  selectType?: boolean;
  selectGeneration?: boolean;
}

const {
  placeholder = "buscar",
  searchText,
  selectType,
  selectGeneration,
} = Astro.props;
---

<form class="SearchFilter flex flex-col gap-2 h-fill">
  <div class="w-full flex movil:flex-col desktop:flex-row gap-1.5">
    <div class="movil:w-full desktop:w-[60%] flex flex-col gap-0.5">
      {
        searchText && (
          <input type="text" id="searchInput" placeholder={placeholder} />
        )
      }
    </div>
    <div class="flex gap-2 movil:w-full desktop:w-[40%]">
      <div class="w-[50%] flex flex-col gap-0.5">
        {
          selectType && (
            <select id="typeSelect" class="text-txt-description3">
              <option value="">Tipo</option>
              {
                types.map((type: string):string[] => (
                  <option value={type}>{type}</option>
                ))
              }
            </select>
          )
        }
      </div>
      <div class="w-[50%] flex flex-col gap-0.5">
        {
          selectGeneration && (
            <select id="generationSelect" class="text-txt-description3">
              <option value="">Generación</option>
              {
                generations.map((generation: { value: number; label: string }) => (
                  <option value={generation.value}>{generation.label}</option>
                ))
              }
            </select>
          )
        }
      </div>
    </div>
  </div>
  <div class="flex gap-1 items-center">
    <span id="generationTag" class="hidden font-primary-300 text-txt-description3 rounded-xs px-1.5 py-0.5 bg-white/10 text-white">Generación</span>
    <span id="typeTag" class="hidden font-primary-300 text-txt-description3 rounded-xs px-1.5 py-0.5 bg-white/10 text-white">Tipo</span>
    <a id="clearFilters" href="/" class="hidden">
      <span class="font-primary-300 text-txt-description3 underline cursor-pointer text-white">
        Limpiar filtros
      </span>
    </a>

  </div>
</form>
