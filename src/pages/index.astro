---
import { Image } from "astro:assets";
import DefaultLayout from "../layout/DefaultLayout.astro";
import { getListPokemons, getIdPokemons } from '../utils/getListPokemon';
import Card from "../components/ui/Card.astro";

const listPokemons = await getListPokemons();
const { results } = listPokemons;
---

<DefaultLayout title="Inicio">
	<section class="flex flex-col gap-10 items-center h-screen">
		<h1 class="font-bold text-4xl">Pokemons List</h1>

		<ul class="grid grid-cols-6 gap-2 items-center justify-center">
			{
				results.map(async ({...item}, idx:number) =>{
          let data = await getIdPokemons(idx + 1);
					console.log(data.sprites.front_shiny);
					return (
						<li>
							<a href={`/pokemons/${data.name}`}>
								<Card name={data.name} url={data.sprites.other.dream_world.front_default} />
							</a>
						</li>
					)
				})
			}
		</ul>
	</section>
</DefaultLayout>
