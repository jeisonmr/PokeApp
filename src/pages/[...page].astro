---
import Layout from "../layout/Layout.astro";
import { getIdPokemons, getListPokemonLimit } from '../utils/getListPokemon';
import Card from "../components/ui/Card.astro";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({paginate} : GetStaticPathsOptions) {
	const listPokemons = await getListPokemonLimit("100");
	const { results } = listPokemons as unknown as { results: { name: string; url: string } };

	return paginate(results, {
		pageSize: 12,
	})	
}

const { page } = Astro.props;

console.log(page);

const listPokemons = await Promise.all(page.data.map(async (pokemon) =>{
	  const id = pokemon.url.split("/").filter(Boolean).pop()!;
    const data = await getIdPokemons(id);
	return {
		name: data.name,
		url: data.sprites.other.dream_world.front_default,
	};
}))
---

<Layout title="Inicio">
	<section class="flex flex-col gap-10 items-center h-screen">
		<h1 class="font-bold text-4xl">Pokemons List</h1>

		<ul class="grid grid-cols-6 gap-2 items-center justify-center">
			{
				listPokemons.map(({name, url}) =>{
					return (
						<li>
							<a href={`/pokemon/${name}?pages=${page.currentPage}`}>
								<Card name={name} url={url} />
							</a>
						</li>
					)
				})
			}
		</ul>
    <nav class="flex gap-6 items-center">
      {page.url.prev && <a href={page.url.prev}>Anterior</a>}
      <span>Página {page.currentPage} de {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Siguiente</a>}
    </nav>
	</section>
</Layout>
