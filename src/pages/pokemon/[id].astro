---
import DefaultLayout from '../../layout/DefaultLayout.astro';
export async function getStaticPaths() {
  const response = await fetch(
    'https://pokeapi.co/api/v2/pokemon?limit=100'
  );

  if (!response.ok) {
    throw new Error('Error al obtener los Pokémon');
  }

  const result = await response.json();

  return result.results.map((pokemon: { url: string; name: string }) => {
    const id = pokemon.url.split('/').filter(Boolean).pop();
    return {
      params: { id },
      props: { name: pokemon.name },
    };
  });
}

const { id } = Astro.params;
const { name } = Astro.props;
---

<DefaultLayout title={`Pokemon: ${name}`}>
  <a href="/">
    <h1>Pokemon {name} {id}</h1>
  </a>
</DefaultLayout>