---
import { Image } from 'astro:assets';
import Layout from '../../layout/Layout.astro';
import { getListPokemonLimit } from '../../utils/getListPokemon';

export async function getStaticPaths() {
  const response = await getListPokemonLimit('700');
  const { results } = response as any;

  if (results.length === 0) {
    throw new Error('Error al obtener los Pokémon');
  }

  

  return results.map((pokemon: { name: string; url: string, page: string }) => {
    const name = pokemon.name as string;
    const url  = pokemon.url as string;
        
    return {
      params: { name },
      props: { 
        name: name,
        url: url,
        page: pokemon.page,
      },
    };
  });
}
const { name } = Astro.params as { name: string };
const { url } = Astro.props as { url: string };
const id = url.split('/').filter(Boolean).pop();

const currentPage =  Astro.url.searchParams.get('pages') ?? 1;

const previousUrl = currentPage === 1
  ? '/'
  : `/${currentPage}/`;
---
<Layout title={`Pokemon ${name}`}>
  <a href={previousUrl}>
    <h1 class="font-bold text-6xl text-center">Pokemon {name}</h1>
    <Image 
    src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/dream-world/${id}.svg`}
    alt={`Imagen de ${name}`} 
    width={200} 
    height={200}
    class="mx-auto w-100 h-auto aspect-square" 
    />
  </a>
</Layout>

