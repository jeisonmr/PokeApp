---
import Banner from '@/components/blocks/Banner.astro';
import Layout from '../../layout/Layout.astro';
import { getNamePokemon, getPokemonLimit } from '@/services/api.services';
import { COUNT_POKEMONS } from '@/utils/constants/services.constans';
import Typoografi from '@core/components/Typographi/Typographi.astro';
import CardBaseStatistics from '@/components/ui/CardBaseStatistics.astro';
import CardSkills from '@/components/ui/CardSkills.astro';
import CardTypeAffinities from '@/components/ui/CardTypeAffinities.astro';
 
export async function getStaticPaths() {
  const response = await getPokemonLimit(COUNT_POKEMONS);

  return response.results.map((pokemon: { name: string; url: string }) => ({
    params: {
      name: pokemon.name
    },
    props: {
      name: pokemon.name,
      url: pokemon.url
    }
  }));
}

const { name, url } = Astro.props as {name: string; url: string;};

const dataStats = await getNamePokemon(name);

const affinities = Promise.all(dataStats.types.map(async ({type}) => {
  const res = await fetch(`https://pokeapi.co/api/v2/type/${type.name}`)
  const data = await res;
  const damageRelations = await data.json();
  
  return damageRelations
}));

const data = await affinities;
const damageRelations = {
  doubleDamageTo: data[0].damage_relations.double_damage_to,
  doubleDamageFrom: data[0].damage_relations.double_damage_from,
  halfDamageTo: data[0].damage_relations.half_damage_to,
  halfDamageFrom: data[0].damage_relations.half_damage_from,
  noDamageTo: data[0].damage_relations.no_damage_to,
  noDamageFrom: data[0].damage_relations.no_damage_from,
};
---

<Layout className="flex flex-col gap-3" title={`Pokemon ${name}`}>

  <Banner singlePage={true} dataPokemon={name} />

  <section id="affinities-base" class="block-padding-medium-x flex flex-col gap-2">
    <Typoografi 
      component="h1" 
      className="text-txt-title2 font-primary-600 "
    >
     Conoce a {name}
    </Typoografi>

    <div class="w-full h-auto flex movil:flex-col desktop:flex-row gap-2">
      <CardBaseStatistics 
        type={dataStats.types[0].type.name} 
        className="w-full desktop:w-1/2" 
        data={dataStats}
      />
      <CardSkills 
        type={dataStats.types[0].type.name} 
        className="w-full desktop:w-1/2" 
        data={dataStats}
      />
    </div>
  </section>
  <section class="block-padding-medium-x flex flex-col gap-1">
    <Typoografi 
      component="h2" 
      className="text-txt-title2 font-primary-600 "
    >
      Afinidades de tipo
    </Typoografi>

    <Typoografi 
      component="p" 
      className="text-txt-description3 font-primary-600 text-white/50"
    >
      Sigue la evolución de la familia de <span class="capitalize">{name}</span>
    </Typoografi>
    
    <div class="w-full grid movil:grid-cols-1 desktop:grid-cols-3 gap-2">
      {
        damageRelations.doubleDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Eficaz contra"
          subtitle={`Ataques de tipo`}
          affinities={damageRelations.doubleDamageTo}
        />
        )
      }
      {
        damageRelations.doubleDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Debilidades"
          subtitle={`Daño recibido por ${name}`}
          affinities={damageRelations.doubleDamageFrom}
        />
        )
      }
      {
        damageRelations.halfDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Poco eficaz contra"
          subtitle="Los siguientes tipos"
          affinities={damageRelations.halfDamageTo}
        />
        )
      }
      {
        damageRelations.halfDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Resistencias"
          subtitle="Daño recibido reducido"
          affinities={damageRelations.halfDamageFrom}
        />
        )
      }
      {
        damageRelations.noDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Inmunidades"
          subtitle="No recibes daño de estos tipos"
          affinities={damageRelations.noDamageFrom}
        />
        )
      }
      {
        damageRelations.noDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Inmune a"
          subtitle="No infliges daño a estos tipos"
          affinities={damageRelations.noDamageTo}
        />
        )
      }
    </div>
  </section>
</Layout>