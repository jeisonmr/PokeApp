---
import Layout from '../../layout/Layout.astro';
import { getPokemonLimit } from '@/services/api.services';

export async function getStaticPaths() {
  const response = await getPokemonLimit(10);

  console.log('Respuesta del servicio:', response);

  if (!response || !Array.isArray(response.results)) {
    throw new Error(
      'getPokemonLimit no devolvió un objeto con un arreglo results'
    );
  }

  return response.results.map((pokemon: { name: string; url: string }) => ({
    params: {
      name: pokemon.name
    },
    props: {
      name: pokemon.name,
      url: pokemon.url
    }
  }));
}

const { name, url } = Astro.props as {
  name: string;
  url: string;
};

const id = url.split('/').filter(Boolean).pop();

const currentPage = Number(Astro.url.searchParams.get('pages') ?? 1);

const previousUrl = currentPage <= 1
  ? '/'
  : `/${currentPage - 1}/`;
---

<Layout title={`Pokemon ${name}`}>
  <a href={previousUrl}>
    <h1 class="text-center text-6xl font-bold">
      Pokemon {name}
    </h1>

    <img
      src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/dream-world/${id}.svg`}
      alt={`Imagen de ${name}`}
      width="200"
      height="200"
      class="mx-auto h-auto w-100 aspect-square"
    />
  </a>
</Layout>