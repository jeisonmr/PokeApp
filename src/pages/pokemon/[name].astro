---
import Banner from '@/components/blocks/Banner.astro';
import Layout from '../../layout/Layout.astro';
import { getNamePokemon, getPokemonLimit, getSpecies, getTypesPokemon, getEvolutionPokemon } from '@/services/api.services';
import { COUNT_POKEMONS } from '@/utils/constants/services.constans';
import Typoografi from '@core/components/Typographi/Typographi.astro';
import CardBaseStatistics from '@/components/ui/CardBaseStatistics.astro';
import CardSkills from '@/components/ui/CardSkills.astro';
import CardTypeAffinities from '@/components/ui/CardTypeAffinities.astro';
import CardPokemonB from '@/components/ui/CardPokemonB.astro';
 
export async function getStaticPaths() {
  const response = await getPokemonLimit(COUNT_POKEMONS);

  return response.results.map((pokemon: { name: string; url: string }) => ({
    params: {
      name: pokemon.name
    },
    props: {
      name: pokemon.name,
      url: pokemon.url
    }
  }));
}

const { name, url } = Astro.props as {name: string; url: string;};

const dataStats = await getNamePokemon(name);
const species = await getSpecies(name);
const primaryType: any[] | string  = dataStats.types || "normal";
const dataSinglePokemon = {
  name: dataStats.name,
  image: dataStats.sprites.other?.dream_world.front_default,
  type: primaryType,
  number: dataStats.id,
  description: species?.flavor_text_entries?.find(({language}: { language: { name: string } }) => {
    return language.name === "es" || language.name === "en";
  })?.flavor_text
};

// Obtener tipos del Pokémon en paralelo
const affinities = await Promise.all(
  dataStats.types.map(({ type }) => getTypesPokemon(type.name))
);

// Validar que existan afinidades antes de extraer damage_relations
const firstTypeRelations = affinities[0]?.damage_relations || {
  double_damage_to: [],
  double_damage_from: [],
  half_damage_to: [],
  half_damage_from: [],
  no_damage_to: [],
  no_damage_from: [],
};

const damageRelations = {
  doubleDamageTo: firstTypeRelations.double_damage_to,
  doubleDamageFrom: firstTypeRelations.double_damage_from,
  halfDamageTo: firstTypeRelations.half_damage_to,
  halfDamageFrom: firstTypeRelations.half_damage_from,
  noDamageTo: firstTypeRelations.no_damage_to,
  noDamageFrom: firstTypeRelations.no_damage_from,
};

const evolution = await getEvolutionPokemon(dataStats.id);
---

<Layout 
  className="flex flex-col gap-3" 
  title={`${name.toUpperCase()}`}
  description={`${dataSinglePokemon.description}`}
  image={dataSinglePokemon.image}
  url={`${Astro.url.origin}/pokemon/${name}`}
  canonical={`${Astro.url.origin}/pokemon/${name}`}
  keywords={dataSinglePokemon.type.map((type: any) => type.type.name).join(", ")}
>

  <Banner singlePage={true} dataPokemon={dataSinglePokemon} />

  <section id="affinities-base" class="block-padding-medium-x flex flex-col gap-2">
    <Typoografi 
      component="h2" 
      className="text-txt-title2 font-primary-600 text-white"
    >
     Conoce a {name}
    </Typoografi>

    <div class="w-full h-auto flex movil:flex-col desktop:flex-row gap-2">
      <CardBaseStatistics 
        type={dataStats.types[0].type.name} 
        className="w-full desktop:w-1/2" 
        data={dataStats}
      />
      <CardSkills 
        type={dataStats.types[0].type.name} 
        className="w-full desktop:w-1/2" 
        data={dataStats}
      />
    </div>
  </section>

  <section class="block-padding-medium-x flex flex-col gap-1">
    <Typoografi 
      component="h2" 
      className="text-txt-title2 font-primary-600 text-white"
    >
      Afinidades de tipo
    </Typoografi>

    <Typoografi 
      component="p" 
      className="text-txt-description3 font-primary-600 text-white/50"
    >
      Sigue la evolución de la familia de <span class="capitalize">{name}</span>
    </Typoografi>
    
    <div class="w-full grid movil:grid-cols-1 desktop:grid-cols-3 gap-2">
      {
        damageRelations.doubleDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Eficaz contra"
          subtitle={`Oponentes de tipo`}
          affinities={damageRelations.doubleDamageTo}
        />
        )
      }
      {
        damageRelations.doubleDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Debilidades"
          subtitle={`${name} tiene debilidades contra los tipos`}
          affinities={damageRelations.doubleDamageFrom}
        />
        )
      }
      {
        damageRelations.halfDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Poco eficaz contra"
          subtitle="Los siguientes tipos"
          affinities={damageRelations.halfDamageTo}
        />
        )
      }
      {
        damageRelations.halfDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Resistencia"
          subtitle="Recibe poco daño de estos tipos"
          affinities={damageRelations.halfDamageFrom}
        />
        )
      }
      {
        damageRelations.noDamageFrom.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Inmunidades"
          subtitle="No recibe daño de estos tipos"
          affinities={damageRelations.noDamageFrom}
        />
        )
      }
      {
        damageRelations.noDamageTo.length > 0 && (
        <CardTypeAffinities
          type={dataStats.types[0].type.name} 
          className="w-full" 
          data={dataStats}
          title="Inmune a"
          subtitle="No infliges daño a estos tipos"
          affinities={damageRelations.noDamageTo}
        />
        )
      }
    </div>
  </section>

  <section class="block-padding-medium-x flex flex-col gap-2">
    <Typoografi 
      component="h2" 
      className="text-txt-title2 font-primary-600 text-white"
    >
      Evolución
    </Typoografi>
    <ul class="w-full grid movil:grid-cols-1 desktop:grid-cols-3 gap-2">
    {
      evolution.map((pokemon: any) => (
        <li class="hover:scale-[1.05] transition-transform duration-200">
          <a href={`/pokemon/${pokemon.name}`}>
            <CardPokemonB
              name={pokemon.name}
              image={pokemon.sprites}
              types={pokemon.types}
            />
          </a>
        </li>
      ))
    }
    </ul>
  </section>
</Layout>