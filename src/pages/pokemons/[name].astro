---
import { Image } from 'astro:assets';
import DefaultLayout from '../../layout/DefaultLayout.astro';

export async function getStaticPaths() {
  const response = await fetch(
    'https://pokeapi.co/api/v2/pokemon?limit=100'
  );

  if (!response.ok) {
    throw new Error('Error al obtener los Pokémon');
  }

  const result = await response.json();

  return result.results.map((pokemon: { name: string; url: string }) => {
    const name = pokemon.name as string;
    const url  = pokemon.url as string;
    console.log(pokemon);
    
    return {
      params: { name },
      props: { 
        name: name,
        url: url,
      },
    };
  });
}
const { name } = Astro.params as { name: string };
const { url } = Astro.props as { url: string };
const id = url.split('/').filter(Boolean).pop();
---
<DefaultLayout title={`Pokemon ${name}`}>
  <a href="/">
    <h1 class="font-bold text-6xl text-center">Pokemon {name}</h1>
    <Image 
    src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/dream-world/${id}.svg`}
    alt={`Imagen de ${name}`} 
    width={200} 
    height={200}
    class="mx-auto w-100 h-auto aspect-square" 
    />
  </a>
</DefaultLayout>

